//function is done
func init_state_machine() {
	// Initialize elevio/hardware
	elevatorAddr := fmt.Sprintf("%s:%d", def.Addr, def.Port)
	//elevio init`s using this function:`: func Init(addr string, numFloors int)
	elevio.Init(elevatorAddr, def.num_floors)
	// Turn off all button lights:
	//this iterates for all floors, times all buttons (hallup, halldown, cab),
	//  and turns them off.
	for floor := 0; floor < def.num_floors; floor++ {
		for button := elevio.ButtonType(0); button < def.num_buttons; button++ {
			elevio.SetButtonLamp(button, floor, false)
		}
	}

	//make channels
	//do we make the go scheduler_function(jammed_status_ch) from here? -----------ask about
	jammed_status_ch := make(chan bool, 10)
	door_timer_reset_ch := make(chan bool, 10)
	door_timer_timeout_ch := make(chan bool, 10)
	//create channels for obstruction-notice from fsm into jammed-function
	is_obstructed_ch := make(chan bool, 10)
	//create channels for watchdogtimer:
	watchdog_reset_ch := make(chan bool, 10)
	watchdog_timeout_ch := make(chan bool, 10)
	//channels for updater:
	current_floor_dir_ch := make(chan def.floor_and_dir, 10)
	//make channels so the elevio/hardware can send fsm messages about events:
	drv_buttons_ch := make(chan elevio.ButtonEvent, 10)
	drv_floors_ch := make(chan int, 10)
		//on startup sends floor int if on sensor.
		//then only sends floor int once when hit a new floor.
	drv_obstr_ch := make(chan bool, 10) 
		//only sends bool on change in obstruction-state
	//drv_stop := make(chan bool)  //-----------------------------------------what should stop-button do?
	to_order_manager_ch := make(chan def.floor_and_dir, 10)
	new_target_ch := make(chan def.floor_and_dir, 10)  
	update_mod_about_button_event_ch := make(chan elevio.ButtonEvent, 10)    

	//make gofunctions:
	go door_timer(door_timer_reset_ch, door_timer_timeout_ch)
	go watchdog_timer(watchdog_reset_ch, watchdog_timeout_ch)

	//man elevator control function
	go control_elevator_fsm(
		current_floor_dir_ch,
		update_mod_about_button_event_ch, 
		drv_obstr_ch,
		drv_floors_ch,
		drv_buttons_ch,
		new_target_ch,   
		is_obstructed_ch,   
		door_timer_reset_ch,    
		door_timer_timeout_ch,
		watchdog_reset_ch,
		to_order_manager_ch,
		)

	//inform scheduler about our jammed-status (jammed = obstr or watchdogtimeout).
	go tell_sched_if_jammed_or_not(is_obstructed_ch, watchdog_timeout_ch, jammed_status_ch)
	//create updater
	go produce_next_elevator_target(current_floor_dir_ch)
	//pull events (button, floor, obstruction-switch)
	go pull_elevio_events_send_to_fsm(drv_buttons_ch, drv_floors_ch, drv_obstr_ch)
}



//function is done
func pull_elevio_events_send_to_fsm(
	drv_buttons_ch chan<- elevio.ButtonEvent, //send-only channels
    drv_floors_ch chan<- int,
    drv_obstr_ch chan<- bool,
	){
	//make threads which poll for events, and send them to us:
	go elevio.PollButtons(drv_buttons_ch) 
	go elevio.PollFloorSensor(drv_floors_ch)
	go elevio.PollObstructionSwitch(drv_obstr_ch) 
	//go elevio.PollStopButton(drv_stop)   //---------------------------what should stop-button do?
}





//function is done.
func control_elevator_fsm(
	current_floor_dir_ch chan  def.floor_and_dir,
	update_mod_about_button_event_ch chan elevio.ButtonEvent,
	drv_obstr_ch chan bool,
	drv_floors_ch chan int,
	drv_buttons_ch chan elevio.ButtonEvent,
	new_target_ch chan def.floor_and_dir,
	is_obstructed_ch chan bool,   
	door_timer_reset_ch chan bool,
	door_timeout_ch chan bool,
	watchdog_reset_ch chan bool,
	to_order_manager_ch chan def.floor_and_dir,
) {         
	var Elevator def.Elevator
	//move elevator downwards, until we hit a floor:
	Elevator.state = def.moving
	fmt.Println("Elevator.state = moving")
	Elevator.dir = elevio.MD_Down
	elevio.SetMotorDirection(Elevator.dir)     
	Elevator.current_floor = def.between_floors
	Elevator.is_obstructed = false
	Elevator.ID = def.LocalId
	//default target is ground floor and stop.
	var current_target def.floor_and_dir
	reset_watchdog_timer(watchdog_reset_ch)
	//main loop:
	for{
		current_target = update_target(current_target, new_target_ch)
		switch Elevator.state{
		case def.moving:
			select {
				case Elevator.is_obstructed = <-drv_obstr_ch:	
					is_obstructed_ch <- Elevator.is_obstructed
					if(Elevator.is_obstructed == true){ 
						elevio.SetMotorDirection(elevio.MD_Stop)
					}else{
						elevio.SetMotorDirection(Elevator.dir)
					}
				case Elevator.current_floor = <-drv_floors_ch:
					tell_updater_floor_dir(Elevator.current_floor, Elevator.dir, current_floor_dir_ch)
					elevio.SetFloorIndicator(Elevator.current_floor)
					//if there is no active order:
					if(current_target.dir == elevio.MD_Stop){
						Elevator.state = def.idle
						fmt.Println("Elevator.state = idle")
						Elevator.dir = current_target.dir
						elevio.SetMotorDirection(Elevator.dir)
					//there is an active order. check if we are on the right floor:
					}else if(Elevator.current_floor == current_target.floor){ 
						elevio.SetMotorDirection(elevio.MD_Stop)
						if(Elevator.dir != current_target.dir){
							Elevator.dir = current_target.dir
						}
						Elevator.state = def.door_open
						fmt.Println("Elevator.state = door_open")
						elevio.SetDoorOpenLamp(true)
						reset_door_timer(door_reset_ch)
						clear_order(Elevator.current_floor, Elevator.dir, to_order_manager_ch)
					}
					//else keep moving in same direction
				case button_event := <-drv_buttons_ch:
					update_mod_about_button_event_ch <- button_event
			}
			reset_watchdog_timer(watchdog_reset_ch)
			time.Sleep(5 * time.Millisecond)
		case def.door_open:
			select {
				case Elevator.is_obstructed = <-drv_obstr_ch:	
					is_obstructed_ch <- Elevator.is_obstructed
					if(Elevator.is_obstructed == false){ 
						reset_door_timer(door_reset_ch) 
					}
				case button_event := <-drv_buttons_ch:
					//if button_event matches our floor and dir now, take order right away. else send to scheduler.
					if(Elevator.current_floor != button_event.Floor){
						update_mod_about_button_event_ch <- button_event
					}else{
						//floor matches, now check direction.
						if((Elevator.dir == elevio.MD_Down) && (button_event.Button == elevio.BT_HallUp)){
							update_mod_about_button_event_ch <- button_event
						}
						else if((Elevator.dir == elevio.MD_Up) && (button_event.Button == elevio.BT_HallDown)){
							update_mod_about_button_event_ch <- button_event
						}
						//(order is cleared because we are already here)
						//cabin-calls to the current floor are also dropped.
					}
				case <-door_timeout_ch:
					if(Elevator.is_obstructed == false){
						elevio.SetDoorOpenLamp(false)
						if(Elevator.dir != current_target.dir){
							Elevator.dir = current_target.dir
						}
						//if we are on same floor as target:
						if(Elevator.current_floor == current_target.floor){  
							//if order is active, then clear it:
							if(Elevator.dir != elevio.MD_Stop){
								clear_order(Elevator.current_floor, Elevator.dir, to_order_manager_ch)
							}
							Elevator.state = def.idle
							fmt.Println("Elevator.state = idle")
						}else{
							Elevator.state = def.moving
							fmt.Println("Elevator.state = moving")
							elevio.SetMotorDirection(Elevator.dir)
						}
					}
			}
			reset_watchdog_timer(watchdog_reset_ch)
			time.Sleep(5 * time.Millisecond)
		case def.idle:
			//"idle" means Elevator is checking/waiting for something to do.
			select {
				case Elevator.is_obstructed = <-drv_obstr_ch:	
					is_obstructed_ch <- Elevator.is_obstructed
				case button_event := <-drv_buttons_ch:
					update_mod_about_button_event_ch <- button_event
				default:
					if(Elevator.is_obstructed == true){ 
						time.Sleep(200 * time.Millisecond)
					}else{
						//check if we have something to do:
						if(current_target.dir != elevio.MD_Stop){
							Elevator.dir = current_target.dir
							if(Elevator.current_floor == current_target.floor){
								Elevator.state = def.door_open
								fmt.Println("Elevator.state = door_open")
								elevio.SetDoorOpenLamp(true)
								reset_door_timer(door_reset_ch)
								clear_order(Elevator.current_floor, Elevator.dir, to_order_manager_ch)
							}else{
								Elevator.state = def.moving
								fmt.Println("Elevator.state = moving")
								elevio.SetMotorDirection(Elevator.dir)
							}
						}else{
							//there is nothing to do.
							time.Sleep(200 * time.Millisecond)
						}
					}		
			}
			reset_watchdog_timer(watchdog_reset_ch)
			time.Sleep(5 * time.Millisecond)
		}
	}
}


//function is done
func update_target(
	current_target def.floor_and_dir,
	new_target_ch chan def.floor_and_dir,
){
	//drain buffer, get only latest target
	for {
		select {
		case latest_target := <-new_target_ch:
			current_target = latest_target 
		default:
			return current_target
		}
	}
}



