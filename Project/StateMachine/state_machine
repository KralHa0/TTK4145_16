func tell_sched_if_jammed_or_not(
	is_obstructed_ch <-chan bool,      //recieve only
    watchdog_timeout_ch <-chan bool, //recieve only
    jammed_status_ch chan<- bool,      //send only
){
	//jammed = obstructed or watchdogtimeout
	var current_is_jammed bool = false
	var new_is_jammed bool = false
	var is_obstr bool = false
	var is_watchdogtimeout bool = false
	var is_first_transmission bool = true
	for{
		//waits for update:
		select {
		case is_obstr = <- is_obstructed_ch:
			fmt.Printf("Obstruction-status: %v\n", is_obstr)
		case is_watchdogtimeout = <- watchdog_timeout_ch:
			fmt.Printf("Watchdogtimeout-status: %v\n", is_watchdogtimeout)
		}
		new_is_jammed = is_obstr || is_watchdogtimeout
		//only alert scheduler, if there has been a change, or on startup
		if((new_is_jammed != current_is_jammed) || is_first_transmission){
			current_is_jammed = new_is_jammed
			jammed_status_ch <- new_is_jammed
			is_first_transmission = false
		} 
	}
}



